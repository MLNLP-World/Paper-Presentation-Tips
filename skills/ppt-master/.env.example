# 在线服务配置示例
# Agent 自带绘图工具时，通常不需要配置生图服务。
# 使用在线服务时：
# 1. 将本文件复制为本地 .env。
# 2. 选择一个 IMAGE_BACKEND，并填入对应服务的密钥、模型和地址。
# 3. 删掉需要启用的配置行开头的 #；其他配置继续保留 #。
# 4. 运行 image_gen.py 时加 --allow-api，表示本次使用在线服务。
# 密钥保留在本机，不提交到 GitHub。
#
# 配置查找顺序：当前工作目录/.env → Skill 目录/.env → 仓库根目录/.env
# → 用户目录/.ppt-master/.env。只读取第一个存在的文件，不合并多个文件。
# 已设置的环境变量优先于 .env。

# 生图服务名称；按下方对应服务填写。
# IMAGE_BACKEND=openai

# 批量生成时同时发送的请求数，默认 3；服务限流时会自动降低。
# IMAGE_CONCURRENCY=3

# 使用各服务自己的配置名，不使用 IMAGE_API_KEY、IMAGE_MODEL、IMAGE_BASE_URL。
# 模型名以自己所选服务提供的名称为准。

# OpenAI 或兼容 OpenAI 接口的服务
# IMAGE_BACKEND=openai
# OPENAI_API_KEY=your-api-key
# OPENAI_MODEL=your-image-model
# OPENAI_BASE_URL=https://your-service.example/v1
# 以下选项通常保留默认值；服务有特殊要求时再调整。
# OPENAI_SIZE_PRESET=auto
# OPENAI_RESPONSE_FORMAT=auto
# 图片质量；可用值以模型和服务支持情况为准。
# OPENAI_QUALITY=auto
# 图片格式：png、jpeg、webp。
# OPENAI_OUTPUT_FORMAT=png
# jpeg/webp 压缩质量：0–100。
# OPENAI_OUTPUT_COMPRESSION=80
# 背景：auto（自动）、opaque（不透明）、transparent（透明）。
# OPENAI_BACKGROUND=auto
# 内容审核选项：auto 或 low；以服务支持情况为准。
# OPENAI_MODERATION=auto
# 参考图保留程度：仅在模型支持时设置 high 或 low。
# OPENAI_INPUT_FIDELITY=high

# Gemini
# IMAGE_BACKEND=gemini
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=your-image-model
# GEMINI_BASE_URL=https://your-service.example

# MiniMax
# IMAGE_BACKEND=minimax
# MINIMAX_API_KEY=your-minimax-key
# MINIMAX_MODEL=image-01
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1/image_generation
# 使用海外服务时可改为：https://api.minimax.io/v1/image_generation

# 通义千问
# IMAGE_BACKEND=qwen
# QWEN_API_KEY=your-dashscope-key
# QWEN_MODEL=your-image-model
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation

# 智谱
# IMAGE_BACKEND=zhipu
# ZHIPU_API_KEY=your-zhipu-key
# ZHIPU_MODEL=your-image-model
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/images/generations

# 火山引擎
# IMAGE_BACKEND=volcengine
# LAS_API_KEY=your-las-key
# VOLCENGINE_MODEL=your-image-model
# VOLCENGINE_BASE_URL=https://operator.las.cn-beijing.volces.com/api/v1
# 使用火山方舟时可改为：https://ark.cn-beijing.volces.com/api/v3

# 腾讯云 TokenHub
# IMAGE_BACKEND=tencent
# TENCENT_API_KEY=your-tokenhub-key
# 也可使用 TOKENHUB_API_KEY 作为密钥变量。
# TENCENT_MODEL=your-image-model
# TENCENT_BASE_URL=https://tokenhub.tencentmaas.com
# 国际服务地址：https://tokenhub-intl.tencentmaas.com
# 以下选项按所选模型设置：
# TENCENT_REVISE=true
# TENCENT_WATERMARK=false
# TENCENT_OUTPUT_FORMAT=png

# 其他适配服务：先用 image_gen.py --list-backends 查看支持的名称，
# 再将 IMAGE_BACKEND 设为对应名称，填写该服务的变量。

# Stability
# STABILITY_API_KEY=your-stability-key
# STABILITY_MODEL=your-image-model
# STABILITY_BASE_URL=https://api.stability.ai

# BFL
# BFL_API_KEY=your-bfl-key
# BFL_MODEL=your-image-model
# BFL_BASE_URL=https://api.bfl.ai

# Ideogram
# IDEOGRAM_API_KEY=your-ideogram-key
# IDEOGRAM_MODEL=your-image-model
# IDEOGRAM_BASE_URL=https://api.ideogram.ai

# SiliconFlow
# SILICONFLOW_API_KEY=your-siliconflow-key
# SILICONFLOW_MODEL=your-image-model
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1/images/generations

# Fal
# FAL_KEY=your-fal-key
# FAL_MODEL=your-image-model
# FAL_BASE_URL=https://fal.run

# Replicate
# REPLICATE_API_TOKEN=your-replicate-token
# REPLICATE_MODEL=your-image-model
# REPLICATE_BASE_URL=https://api.replicate.com/v1

# OpenRouter
# OPENROUTER_API_KEY=your-openrouter-key
# OPENROUTER_MODEL=your-image-model
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ModelScope
# IMAGE_BACKEND=modelscope
# MODELSCOPE_API_KEY=your-modelscope-key
# MODELSCOPE_MODEL=your-image-model
# MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1

# 可以同时保存多个服务的配置；切换服务时修改 IMAGE_BACKEND。

# 旁白配音（可选）
# 默认 edge-tts 无需 API Key。选择其他配音服务时再填写下面对应的密钥。
# 如果需要克隆音色，先在服务商处取得 voice_id，再通过 --voice-id 传给
# notes_to_audio.py。操作说明见 references/commands/narration.md。
# ELEVENLABS_API_KEY=your-elevenlabs-api-key
# MINIMAX_API_KEY=your-minimax-key
# QWEN_API_KEY=your-dashscope-key
# COSYVOICE_API_KEY=your-dashscope-key
# DASHSCOPE_API_KEY=your-dashscope-key
# 以下地址仅在需要指定配音接口时填写。
# MINIMAX_TTS_BASE_URL=https://api.minimaxi.com/v1/t2a_v2
# 海外地址：https://api.minimax.io/v1/t2a_v2
# QWEN_TTS_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
# COSYVOICE_TTS_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer

# 网络图片搜索（可选）
# 图片搜索和生图分别配置。Openverse、Wikimedia 无需密钥；
# 使用 Pexels 或 Pixabay 时，可在对应网站申请密钥。
# Pexels：https://www.pexels.com/api/
# PEXELS_API_KEY=your-pexels-key
# Pixabay：https://pixabay.com/api/docs/
# PIXABAY_API_KEY=your-pixabay-key
